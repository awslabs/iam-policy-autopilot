{
  "description": "single policy, single service - index maps service prefix to policy ARN",
  "policies": [
    {
      "arn": "arn:aws:iam::aws:policy/AmazonS3ReadOnlyAccess",
      "name": "AmazonS3ReadOnlyAccess",
      "default_version_id": "v10",
      "document": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Action": ["s3:GetObject", "s3:ListBucket"],
            "Resource": "*"
          }
        ]
      }
    }
  ],
  "catalogue": {
    "s3": ["GetObject", "GetBucketAcl", "ListBucket", "PutObject"]
  },
  "expected_service_prefixes": ["s3"],
  "expected_policy_arns_for_s3": ["arn:aws:iam::aws:policy/AmazonS3ReadOnlyAccess"],
  "expected_concrete_action_count_for_arn": {
    "arn:aws:iam::aws:policy/AmazonS3ReadOnlyAccess": 2
  }
}
