# Rust build output (this is a separate Cargo workspace)
target/

# Benchmark outputs (generated by the benchmarker; large, machine-specific)
results/
benchmarker_results/
real-world-apps/realworld_results/

# Persistent caches (service catalogue, managed-policy index, etc.)
.cache/
real-world-apps/.cache/
.iac-benchmarker/

# Generated cache/report JSON written by the benchmarker / analyzers when run
# with a cache-dir or output-dir inside the workspace (default cache-dir is
# ~/.iac-benchmarker/, but these land at the workspace root if pointed here).
# Scoped to the workspace root ("/") so it does NOT match the identically-named
# committed test fixtures under iac-benchmarker/tests/fixtures/.
/service_catalogue_cache.json
/service_reference_cache.json
/managed_policy_cache.json
/policy_index.json
/aggregate_report.json
/coverage_report.json

# Ground-truth policies regenerated from a live deployment (committed copies
# under real-world-apps/genai-chatbot/handlers/*/deployed_policy/ are kept; this
# only ignores an alternative top-level extraction location if one is used)
/deployed_policy/

# Upstream aws-genai-llm-chatbot@50b6c6e is committed as a tarball
# (real-world-apps/genai-chatbot-cdk-50b6c6e.tar.gz). The directory it extracts
# to is a build/deploy workspace and must not be committed.
real-world-apps/genai-chatbot-cdk/

# Generated CDK synthesis output and per-language build artifacts from runs
**/cdk.out/
**/node_modules/
**/.venv/
**/__pycache__/
**/go/script

# LaTeX figure output (regenerate with make_figures.sh)
paper/figures/
